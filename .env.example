SECRET_KEY=change-this-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Kosongkan DATABASE_URL untuk menggunakan SQLite lokal.
# Untuk PostgreSQL/Supabase, isi connection string PostgreSQL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Saat deploy di Render:
# CSRF_TRUSTED_ORIGINS=https://nama-aplikasi.onrender.com

MAX_UPLOAD_SIZE_MB=50
